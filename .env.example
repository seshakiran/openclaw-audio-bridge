# ─── Audio Settings ──────────────────────────────────────────
# Find your mic index: python -c "import sounddevice; print(sounddevice.query_devices())"
MICROPHONE_INDEX=0

# Whisper model: 'tiny' (fastest), 'base' (balanced), 'small' (most accurate)
WHISPER_MODEL=base

# ─── TTS Settings ────────────────────────────────────────────
# 'fast' = pocket-tts (~0.5x real-time, lighter)
# 'quality' = Chatterbox-Turbo (~0.36x real-time, ElevenLabs-quality)
TTS_MODEL=quality

# ─── OpenClaw Settings ───────────────────────────────────────
OPENCLAW_SESSION_ID=agent:main:main
